  "assumptions": [
    {
      "id": "A-CLIENT-IDENTITY",
      "statement": "The client generates and persists one random canonical UUID v4 per provider account, never derives it from a credential, and allocates a new value for a replacement account.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-CLIENT-INTEGRATION",
      "statement": "The client uses the SDK reference APIs, does not infer bindings from addresses, and reconciles rather than blindly replaying an unknown mutation outcome.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-VAULT-CRYPTO",
      "statement": "Vault encryption, key handling, authentication, and decrypted-memory controls protect the complete cipher and hidden alias reference.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-SYNC-PERSISTENCE",
      "statement": "The client atomically encrypts and persists returned ciphers, applies an appropriate sync conflict policy, and supplies a complete provider inventory when completeness-dependent results are used.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-AUTOFILL",
      "statement": "The client applies its normal origin and user-intent checks to login.username and never displays or autofills the hidden reference payload.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-PROVIDER",
      "statement": "The authenticated provider account owns the stable IDs, enforces authorization, keeps IDs stable and non-zero, and returns truthful fresh reads.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-TRANSPORT",
      "statement": "TLS, PKI, DNS, the host runtime, and the configured provider origin are trustworthy beyond the checked redirect and URL-shape controls.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-MAIL-EDGE",
      "statement": "The owned provider, mailbox, DNS, and downstream mail systems apply the intended routing and retention policy; content confidentiality and authenticity require separate controls.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-BACKUP",
      "statement": "Product export, backup, import, and restore preserve the hidden field and protect backup material according to whether it is plaintext or encrypted.",
      "proofStatus": "not-mathematically-proven"
    },
    {
      "id": "A-ARTIFACT",
      "statement": "Consumers verify source and artifact provenance and do not substitute bindings or an unhardened feature configuration.",
      "proofStatus": "not-mathematically-proven"
    }
  ],
