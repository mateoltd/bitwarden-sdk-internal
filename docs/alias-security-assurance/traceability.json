        "EV-RUST-RECONCILIATION",
        "EV-RUST-CONFORMANCE"
      ]
    },
    {
      "id": "C-TRANSPORT-01",
      "status": "supported",
      "statement": "The provider API boundary rejects authenticated redirects and automatic replay, bounds responses, sanitizes errors, and turns post-dispatch transport loss into an unknown mutation outcome.",
      "operations": ["create", "send-reply", "revoke"],
      "assumptions": ["A-TRANSPORT", "A-PROVIDER"],
      "evidence": ["EV-RUST-CLIENT", "EV-RUST-CLIENT-TESTS", "EV-WASM-ADVERSARIAL"]
    },
    {
      "id": "C-SECRET-01",
      "status": "supported",
      "statement": "Canonical references contain exactly six non-credential fields, reject unknown fields, and are handled by non-echoing error paths; this is not a process-wide noninterference theorem.",
