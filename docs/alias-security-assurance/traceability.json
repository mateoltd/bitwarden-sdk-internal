      "assumptions": ["A-VAULT-CRYPTO", "A-ARTIFACT"],
      "evidence": [
        "EV-SECURITY-CONTRACT",
        "EV-TLA-VAULT",
        "EV-CONFORMANCE-VECTORS",
        "EV-RUST-CLIENT-TESTS"
      ]
    },
